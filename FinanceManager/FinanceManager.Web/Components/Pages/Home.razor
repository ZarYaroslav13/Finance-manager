@page "/"
@page "/home"
@attribute [Authorize]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Home> _localizer

<MudContainer>
    <MudGrid>
        <MudItem xs="12" sm="12" md="12">
            <div class="d-flex justify-center mt-4">
                <MudIcon Icon="@CustomIcons.FinanceManager" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" ViewBox="0 0 500 500" Style="width: 250px; height: 250px;" />

                @* <MudImage Src="@CustomImagesSource.BigLogo" ObjectFit="@ObjectFit.Cover" /> *@
            </div>
        </MudItem>
        <MudItem xs="12" sm="12" md="12">
            <MudText Align="MudBlazor.Align.Center" Typo="Typo.h2">@_localizer["Title"] v2.2</MudText>
            <MudText Align="MudBlazor.Align.Center" Typo="Typo.h5" Class="smaller">@_localizer["Description"]</MudText>
        </MudItem>
        
        <div style="margin:50px"></div>
    </MudGrid>
</MudContainer>