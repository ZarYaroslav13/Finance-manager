@page "/finance-operation-types"
@page "/finance-operation-types/{WalletId:guid}"
@using FinanceManager.Application.UseCases.FinanceOperationTypes.Commands.UpdateFinanceOperationTypeCommand
@using FinanceManager.Web.ViewModels.Components.Pages.Tools.FinanceOperationTypes
@using FinanceManager.Application.Models
@inject FinanceOperationTypesPageViewModel _viewModel


<style>
    .mud-table-cell-custom-group {
        font-weight: 500;
    }

    .mud-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }
</style>

<MudTable Items="@_viewModel.TableData.Items"
          @ref="_viewModel.TableData"
           
          Hover="true" Dense="true" Striped="true" FixedHeader="true" FixedFooter="true"

          IsEditRowSwitchingBlocked="true" 
          CanCancelEdit="true" 
          EditTrigger="TableEditTrigger.EditButton" 
          EditButtonPosition="TableEditButtonPosition.End"

          RowEditPreview="@((type) => _viewModel.OnRowEditPreview((FinanceOperationTypeDTO)type))"
          RowEditCommit="@((type) => _viewModel.OnRowEditCommit((FinanceOperationTypeDTO)type))"
          RowEditCancel="@((type) => _viewModel.OnRowEditCancel((FinanceOperationTypeDTO)type))"

          GroupFooterClass="mb-4"
          GroupBy="@_viewModel.GroupDefinition"
          GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"

          HeaderClass="mt-8"
          Class="my-5 pt-10">
    <ToolBarContent>
        <div class="d-flex align-center justify-space-between mud-width-full py-4">
            <MudText Typo="Typo.h3">@_viewModel.Localizer["Your finincial types"]</MudText>
            <MudSpacer />
            <MudStack Row="true">
                <MudSelect T="string" Label="@_viewModel.Localizer["Filter properity"]" @bind-Value="@_viewModel.FilterProperty" Immediate="true"
                           Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FilterList">
                    @foreach (var item in _viewModel.LocalizedTableLabels)
                    {
                        <MudSelectItem Value="item.Value" />
                    }
                </MudSelect>

                <MudTextField T="string" Label="@_viewModel.Localizer["Filter value"]" Immediate="true"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Sharp.FilterAlt" @bind-Value="@_viewModel.FilterValue" />
            </MudStack>
        </div>
    </ToolBarContent>
    <HeaderContent>
        @foreach (var item in _viewModel.SortFunctions)
        {
            <MudTh><MudTableSortLabel SortBy=@item.Value T="FinanceOperationTypeDTO">@_viewModel.Localizer[item.Key]</MudTableSortLabel></MudTh>
        }
        <MudTh/>
    </HeaderContent>
    <GroupHeaderTemplate>
        <MudTh Class="mud-table-cell-custom-group" colspan="5">@($"{context.GroupName}: {context.Key}") </MudTh>
    </GroupHeaderTemplate>
    <ColGroup>
        <col style="width: 60px;" />
        <col />
        <col />
        <col />
        <col />
        <col />
        <col />
    </ColGroup>
    <GroupFooterTemplate>
        <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="5">
            @_viewModel.Localizer["Total types:"] @context.Items.Count()
            </MudTh>
    </GroupFooterTemplate>
    <RowTemplate>
        @foreach (var item in _viewModel.SortFunctions)
        {
            var color = GetColor(context);
            <MudTd DataLabel="@item.Key"><MudText Color="@color">@context.GetType().GetProperty(item.Key).GetValue(context)</MudText></MudTd>
        }
        <MudTd/>
    </RowTemplate>
    <RowEditingTemplate>
        <MudTd><MudTextField T="string" @bind-Value="context.Name"></MudTextField></MudTd>
        <MudTd><MudTextField T="string" @bind-Value="context.Description"></MudTextField></MudTd>
        <MudTd>
            <MudSelect T="@EntryType" @bind-Value="context.EntryType">
                @foreach (EntryType item in typeof(EntryType).GetEnumValues())
                {
                    <MudSelectItem T="@EntryType" Value="item">@_viewModel.Localizer[$"{item.ToString()}"]</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd>
            <MudSelect T="string" @bind-Value="context.WalletName" Class="py-8" Label="@_viewModel.Localizer["Select Wallet"]">
                @foreach (var item in _viewModel.Wallets)
                {
                    <MudSelectItem T="string" Value="@item.Name">
                        <MudText Class="mud-text-body2 mb-0">@_viewModel.Localizer["Wallet name:"] @item.Name</MudText>
                        <MudText Class="mud-text-caption">@_viewModel.Localizer["balance:"] @item.Balance</MudText>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudTd>
    </RowEditingTemplate>
    <EditButtonContent Context="button">
        <MudIconButton 
            Icon="@Icons.Material.Rounded.Edit"
            Style="background-color:lightseagreen"
            Size=" MudBlazor.Size.Small"
            OnClick="@button.ButtonAction"
            Disabled="@button.ButtonDisabled"/>


        <MudIconButton Icon="@CustomIcons.ActionIcons.Delete" 
                       Color="MudBlazor.Color.Error" 
                       Style="background-color:#fce4ec"
                       Size=" MudBlazor.Size.Small"
                       OnClick="@(() => _viewModel.DeleteItem((FinanceOperationTypeDTO)button.Item))" />
    </EditButtonContent>
    <LoadingContent>
        <MudText>@_viewModel.Localizer["Loading..."]</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <MudText>@_viewModel.Localizer["No matching records found"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

<MudFab Color="MudBlazor.Color.Tertiary"
        StartIcon="@Icons.Material.Filled.Add"
        DropShadow="true"
        Style="position: fixed; bottom: 24px; right: 24px;" />


@code {
    [Parameter]
    public Guid WalletId
    {
        get => _viewModel.WalletId;
        set => _viewModel.WalletId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnInitializedAsync();
    }

    protected MudBlazor.Color GetColor(FinanceOperationTypeDTO item)
    {
        return item.EntryType == EntryType.Income ? MudBlazor.Color.Success : MudBlazor.Color.Error;
    }

}
