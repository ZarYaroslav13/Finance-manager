@page "/finance-operations"
@page "/finance-operations/{TypeId:guid}"
@using FinanceManager.Application.UseCases.FinanceOperations.Commands.UpdateFinanceOperationCommand
@using FinanceManager.Web.ViewModels.Components.Pages.Personal.FinanceOperations
@using FinanceManager.Application.Models
@inject FinanceOperationsPageViewModel _viewModel
@attribute [Authorize]


<style>
    .mud-table-cell-custom-group {
        font-weight: 500;
    }

    .mud-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }
</style>

<MudTable Items="@_viewModel.TableData.Items"
          @ref="_viewModel.TableData"
           
          Hover="true" Dense="true" Striped="true" FixedHeader="true" FixedFooter="true"

          IsEditRowSwitchingBlocked="true" 
          CanCancelEdit="true" 
          EditTrigger="TableEditTrigger.EditButton" 
          EditButtonPosition="TableEditButtonPosition.End"
          RowEditPreview="@((operation) => _viewModel.OnRowEditPreview((FinanceOperationDTO)operation))"
          RowEditCommit="@((operation) => _viewModel.OnRowEditCommit((FinanceOperationDTO)operation))"
          RowEditCancel="@((operation) => _viewModel.OnRowEditCancel((FinanceOperationDTO)operation))"

          GroupFooterClass="mb-4"
          GroupBy="@_viewModel.GroupDefinition"
          GroupHeaderStyle="background-color:var(--mud-palette-background-gray)"

          HeaderClass="mt-8"
          Class="my-5 pt-10">
    <ToolBarContent>
        <div class="d-flex align-center justify-space-between mud-width-full py-4">
            <MudText Typo="Typo.h4">@_viewModel.Localizer["Your finincial operations"]</MudText>
            <MudSpacer  />

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Style="min-width: 40%; max-width: 55%;">
                
                <MudSelect T="string" Label="@_viewModel.Localizer["Filter properity"]" @bind-Value="@_viewModel.FilterProperty" Immediate="true"
                           Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.FilterList">
                    @foreach (var item in _viewModel.LocalizedTableLabels)
                    {
                        <MudSelectItem Value="item.Key">
                            @item.Value
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (_viewModel.FilterProperty != FinanceOperationsPageViewModel.TableLabels.Date)
                {
                    <MudTextField T="string" Label="@_viewModel.Localizer["Filter value"]" Immediate="true"
                    Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Sharp.FilterAlt" @bind-Value="@_viewModel.FilterValue" />
                }
                else
                {
                    <MudDatePicker Label="@_viewModel.Localizer["Start Date"]" @bind-Date="@_viewModel.FilterStartDate" Editable="true"
                           PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy" Immediate="true"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                           color: white !important;" />
                    <MudTimePicker Label="@_viewModel.Localizer["Start Time"]" @bind-Time="_viewModel.FilterStartDateTime" Editable="true"
                           Culture="@System.Globalization.CultureInfo.CurrentCulture" Immediate="true"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                           color: white !important;" />

                    <MudDatePicker Label="@_viewModel.Localizer["End Date"]" @bind-Date="@_viewModel.FilterEndDate" Editable="true"
                           PickerVariant="PickerVariant.Dialog" DateFormat="dd/MM/yyyy" Immediate="true"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                           color: white !important;" />
                    <MudTimePicker Label="@_viewModel.Localizer["End Time"]" @bind-Time="@_viewModel.FilterEndDateTime" Editable="true"
                           Culture="@System.Globalization.CultureInfo.CurrentCulture" Immediate="true"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                           color: white !important;" />
                }
            </MudStack>
        </div>
    </ToolBarContent>
    <HeaderContent>
        @foreach (var item in _viewModel.SortFunctions)
        {
            <MudTh><MudTableSortLabel SortBy=@item.Value T="FinanceOperationDTO">@_viewModel.LocalizedTableLabels[item.Key]</MudTableSortLabel></MudTh>
        }
        <MudTh/>
    </HeaderContent>
    <GroupHeaderTemplate>
        <MudTh Class="mud-table-cell-custom-group" colspan="5">@($"{context.GroupName}: {context.Key}") </MudTh>
    </GroupHeaderTemplate>
    <ColGroup>
        <col style="width: 60px;" />
        <col />
        <col />
        <col />
        <col />
        <col />
    </ColGroup>
    <GroupFooterTemplate>
        @if (context.GroupName == _viewModel.GroupDefinition.GroupName)
        {
            <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="5">
                @_viewModel.Localizer["Total types:"] @context.Items.DistinctBy(t => t.Type.Id).Count()
            </MudTh>
        }
        else
        {
            <MudTh Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="5">
                @_viewModel.Localizer["Total operations:"] @context.Items.Count()
            </MudTh>
        }
    </GroupFooterTemplate>
    <RowTemplate>

        <MudTd DataLabel="@FinanceOperationsPageViewModel.TableLabels.WalletName"><MudText Color="@GetColor(context)">@context.Type.WalletName</MudText></MudTd>
        <MudTd DataLabel="@FinanceOperationsPageViewModel.TableLabels.TypeName"><MudText Color="@GetColor(context)">@context.Type.Name</MudText></MudTd>
        <MudTd DataLabel="@FinanceOperationsPageViewModel.TableLabels.Amount"><MudText Color="@GetColor(context)">@context.Amount</MudText></MudTd>
        <MudTd DataLabel="@FinanceOperationsPageViewModel.TableLabels.Date"><MudText Color="@GetColor(context)">@context.Date</MudText></MudTd>
        <MudTd/>
    </RowTemplate>
    <RowEditingTemplate>
        <MudTd>
            <MudSelect T="FinanceOperationTypeDTO" @bind-Value="_viewModel.NewType" Class="py-8" Label="@_viewModel.Localizer["Select Type"]">
                @foreach (var item in _viewModel.FinancialOperationsTypes)
                {
                    <MudSelectItem T="FinanceOperationTypeDTO" Value="@item">
                        <MudText Class="mud-text-body2 mb-0">@_viewModel.Localizer["Type name:"] @item.Name</MudText>
                        <MudText Class="mud-text-caption">@_viewModel.Localizer["Type entry:"] @item.EntryType</MudText>
                        <MudText Class="mud-text-caption">@_viewModel.Localizer["Type wallet:"] @item.WalletName</MudText>
                    </MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd>
            <MudTextField Immediate=true For="@(() => context.Amount)" @bind-Value="context.Amount" Label="@_viewModel.Localizer["Balance"]" />
        </MudTd>
        <MudTd>
            <MudDatePicker Label="@_viewModel.Localizer["Date"]"
                           @bind-Date="@_viewModel.NewDate"
                           Culture="@System.Globalization.CultureInfo.CurrentCulture"
                           MaxDate="@DateTime.Today"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                            color: white !important" />

            <MudTimePicker Label="@_viewModel.Localizer["Select time"]"
                           @bind-Time="@(_viewModel.NewTime)"
                           Culture="@System.Globalization.CultureInfo.CurrentCulture" 
                           Editable="true"
                           Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                           color: white !important;"/>
        </MudTd>
    </RowEditingTemplate>
    <EditButtonContent Context="button">
        <MudIconButton 
            Icon="@Icons.Material.Rounded.Edit"
            Style="background-color:lightseagreen"
            Size=" MudBlazor.Size.Small"
            OnClick="@button.ButtonAction"
            Disabled="@button.ButtonDisabled"/>


        <MudIconButton Icon="@CustomIcons.ActionIcons.Delete" 
                       Color="MudBlazor.Color.Error" 
                       Style="background-color:#fce4ec"
                       Size=" MudBlazor.Size.Small"
                       OnClick="@(() => _viewModel.DeleteItem((FinanceOperationDTO)button.Item))" />
    </EditButtonContent>
    <LoadingContent>
        <MudText>@_viewModel.Localizer["Loading..."]</MudText>
    </LoadingContent>
    <NoRecordsContent>
        <MudText>@_viewModel.Localizer["No matching records found"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

<MudFab Color="MudBlazor.Color.Tertiary"
        StartIcon="@Icons.Material.Filled.Add"
        DropShadow="true"
        Style="position: fixed; bottom: 24px; right: 24px;"
        OnClick="@_viewModel.CreateFinancialOperation"/>


@code {
    [Parameter]
    public Guid TypeId
    {
        get => _viewModel.TypeId;
        set => _viewModel.TypeId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnInitializedAsync(StateHasChanged);
    }

    protected MudBlazor.Color GetColor(FinanceOperationDTO item)
    {
        return item.Type.EntryType == EntryType.Income ? MudBlazor.Color.Success : MudBlazor.Color.Error;
    }
}
