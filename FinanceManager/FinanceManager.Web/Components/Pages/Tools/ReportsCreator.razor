@page "/report-creator"
@attribute [Authorize]
@using FinanceManager.Web.Services.Reports
@using FinanceManager.Web.ViewModels.Components.Pages.Tools.ReportCreator
@inject ReportCreatorViewModel _viewModel


<MudContainer>
    <MudSelect T="FinancialReportVariant"
               Label="@_viewModel.Localizer["Variant of financial report"]"
               @bind-Value="_viewModel.SelectedReportVariant"
               
               Placeholder="true">
        @foreach (var item in _viewModel.ReportVariants)
        {
            <MudSelectItem T="FinancialReportVariant" Value="@item">
                <MudIcon Icon="@CustomIcons.Reports.Icons[item]"/> @item.GetDescription()
            </MudSelectItem>
        }
    </MudSelect>
    
    <MudDivider Class="my-2" Style="height: 7px;"/>

    @if (_viewModel.SelectedReportVariant == FinancialReportVariant.Daily)
    {
        <MudPaper Class="pa-4" Elevation="1">
            <EditForm Model="@_viewModel.DailyReportRequestModel" OnValidSubmit="@(()=> @_viewModel.CreateReport(FinancialReportVariant.Daily))">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">

                    <MudSelect Label="@_viewModel.Localizer["Wallet"]"
                               @bind-Value="_viewModel.DailyReportRequestModel.WalletId"
                               T="Guid"
                               Placeholder="true">
                        @foreach (var wallet in _viewModel.Wallets)
                        {
                            <MudSelectItem T="Guid" Value="@wallet.Id">@wallet.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Label="@_viewModel.Localizer["Date"]"
                                   @bind-Date="_viewModel.DailyReportRequestModel.Date"
                                   Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                   MaxDate="@DateTime.Today"
                                   Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                color: white" important />


                    <MudButton ButtonType="@ButtonType.Submit" Color="MudBlazor.Color.Primary" Variant="Variant.Filled">
                        @_viewModel.Localizer["Generate Report"]
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="1">
            <EditForm Model="@_viewModel.PeriodReportRequestModel" OnValidSubmit="@(()=> @_viewModel.CreateReport(FinancialReportVariant.Period))">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">

                    <MudSelect Label="@_viewModel.Localizer["Wallet"]"
                               @bind-Value="_viewModel.PeriodReportRequestModel.WalletId"
                               T="Guid"
                               Placeholder="true">
                        @foreach (var wallet in _viewModel.Wallets)
                        {
                            <MudSelectItem T="Guid" Value="@wallet.Id">@wallet.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Label="@_viewModel.Localizer["Start date"]"
                                   @bind-Date="_viewModel.PeriodReportRequestModel.StartDate"
                                   Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                   MaxDate="@DateTime.Today"
                                   Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                color: white" important />
                                   
                    <MudDatePicker Label="@_viewModel.Localizer["End date"]"
                                   @bind-Date="_viewModel.PeriodReportRequestModel.EndDate"
                                   Culture="@System.Globalization.CultureInfo.CurrentCulture"
                                   MaxDate="@DateTime.Today"
                                   Style=" background: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%) !important;
                color: white" important />


                    <MudButton ButtonType="@ButtonType.Submit" Color="MudBlazor.Color.Primary" Variant="Variant.Filled">
                        @_viewModel.Localizer["Generate Report"]
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    }

@if(_viewModel.ShowReport)
    {
    
    <MudDivider Class="my-2" Style="height: 7px;"/>

    <MudCard Class="mx-auto my-4 p-4" Style="max-width: 800px;">
        <MudCardHeader>
            <MudText Align="MudBlazor.Align.Center" Typo="Typo.h4"><strong>@_viewModel.Localizer["Report for Wallet"] (@_viewModel.Report.WalletName)</strong></MudText>

            <MudCardActions>
                <MudButtonGroup Color="MudBlazor.Color.Tertiary" Variant="Variant.Filled">
                <MudButton EndIcon="@Icons.Material.Rounded.Download">@_viewModel.Localizer["Export report"]</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Style="align-self: auto;">
                    <MudMenuItem OnClick="() => _viewModel.DownloadReport(FileType.Excel)" ><MudIcon Icon="@CustomIcons.ImportExportTypes.Excel"/>  @_viewModel.Localizer["Excel"]</MudMenuItem>
                    <MudMenuItem OnClick="() => _viewModel.DownloadReport(FileType.Word)" ><MudIcon Icon="@CustomIcons.ImportExportTypes.Word"/>  @_viewModel.Localizer["Word"]</MudMenuItem>
                    <MudMenuItem OnClick="() => _viewModel.DownloadReport(FileType.PDF)" ><MudIcon Icon="@CustomIcons.ImportExportTypes.PDF"/>  @_viewModel.Localizer["PDF"]</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>
            </MudCardActions>
        </MudCardHeader>

        <MudCardContent>
            <MudStack Spacing="2">
                <MudText><strong>@_viewModel.Localizer["Wallet Name:"]</strong> @_viewModel.Report.WalletName</MudText>
                <MudText><strong>@_viewModel.Localizer["Balance:"]</strong> @_viewModel.Report.Balance <MudIcon Icon="@CustomIcons.Money.Banknote" /></MudText>
                <MudText><strong>@_viewModel.Localizer["Total Income:"]</strong> @_viewModel.Report.TotalIncome <MudIcon Icon="@CustomIcons.Money.Banknote" /></MudText>
                <MudText><strong>@_viewModel.Localizer["Total Expense:"]</strong> @_viewModel.Report.TotalExpense <MudIcon Icon="@CustomIcons.Money.Banknote" /></MudText>
                <MudText><strong>@_viewModel.Localizer["Period:"]</strong> @_viewModel.Report.Period.StartDate.ToShortDateString() - @_viewModel.Report.Period.EndDate.ToShortDateString()</MudText>
            </MudStack>

            <MudDivider Class="my-2" Style="height: 3px;"/>

            <MudText Typo="Typo.subtitle1" Class="mt-2">@_viewModel.Localizer["Operations"]</MudText>

            @if (_viewModel.Report.Operations is not null && _viewModel.Report.Operations.Any())
            {
            <MudTable Items="_viewModel.Report.Operations" Elevation="0" Dense="true" Bordered="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudText Typo="Typo.subtitle2">Name</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2">Profit</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2">Amount</MudText></MudTh>
                    <MudTh><MudText Typo="Typo.subtitle2">Date</MudText></MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var isProfit = context.Type.EntryType == EntryType.Income;
                        var colorClass = isProfit ? "text-success" : "text-danger";
                        var sign = isProfit ? "+" : "-";
                    }
                    <MudTd Class="@colorClass">@context.Type.Name</MudTd>
                    <MudTd Class="@colorClass">@((isProfit) ? "Yes" : "No")</MudTd>
                    <MudTd Class="@colorClass">@($"{sign}{context.Amount}") <MudIcon Icon="@CustomIcons.Money.Banknote" /></MudTd>
                    <MudTd Class="@colorClass">@context.Date.ToShortDateString()</MudTd>
                </RowTemplate>
            </MudTable>                    

            <MudDivider Class="my-2" Style="height: 5px;"/>
                <MudText Align="MudBlazor.Align.Center" Typo="Typo.h5" Class="mt-2"><strong>@_viewModel.Localizer["Charts"]</strong></MudText>

                <MudGrid>
                    <MudItem xs="4" md="4" Class="d-flex justify-center align-center my-auto">
                        <MudSwitch 
                            T="bool" 
                            @bind-Value="_viewModel.ShowOperationshistoryChart" 
                            LabelPlacement="@Placement.Left" 
                            Color="MudBlazor.Color.Success" UncheckedColor="MudBlazor.Color.Error">@_viewModel.Localizer["Show operation history chart"]</MudSwitch>
                    </MudItem>
                    <MudItem xs="4" md="4" Class="d-flex justify-center align-center my-auto">
                        <MudSwitch 
                            T="bool" 
                            @bind-Value="_viewModel.ShowEntryTypesAmountChart" 
                            LabelPlacement="@Placement.Left" 
                            Color="MudBlazor.Color.Success" UncheckedColor="MudBlazor.Color.Error">@_viewModel.Localizer["Show financial types entries amounts chart"]</MudSwitch>
                    </MudItem>
                    <MudItem xs="4" md="4" Class="d-flex justify-center align-center my-auto">
                        <MudSwitch 
                            T="bool" 
                            @bind-Value="_viewModel.ShowTypesAmountChart" 
                            LabelPlacement="@Placement.Left" 
                            Color="MudBlazor.Color.Success" UncheckedColor="MudBlazor.Color.Error">@_viewModel.Localizer["Show financial types amounts chart"]</MudSwitch>
                    </MudItem>
                </MudGrid>

                if (_viewModel.ShowOperationshistoryChart)
                {
                    <MudText Typo="Typo.h6" Class="mt-2"><strong>@_viewModel.Localizer["Operation history chart"]</strong></MudText>
                    <MudDivider Class="my-2" Style="height: 3px;"/>

                    <ApexChart 
                        TItem="ApexChartValue<DateTime, int>"
                        Options="@_viewModel.OperationsHistoryChartOptions" >
                        <ApexPointSeries TItem="ApexChartValue<DateTime, int>"
                            Items="_viewModel.OperationsHistoryValues"
                            SeriesType="SeriesType.Bar"
                            XValue="@(e => e.ValueX)"
                            YValue="@(e => e.ValueY)"
                            PointColor="e=> e.Color" ShowDataLabels />
                    </ApexChart>
                }
                
                if (@_viewModel.ShowEntryTypesAmountChart)
                {
                    <MudText Typo="Typo.h6" Class="mt-2"><strong>@_viewModel.Localizer["Entry types amount chart"]</strong></MudText>
                    <MudDivider Class="my-2" Style="height: 3px;"/>

                    <ApexChart TItem="ApexChartValue<int>" >
                        <ApexPointSeries TItem="ApexChartValue<int>"
                            Items="_viewModel.EntryTypesApexValues"
                            SeriesType="SeriesType.Pie"
                            XValue="@(e => e.Label)"
                            YValue="@(e => e.Value)"
                            PointColor="e=> e.Color" ShowDataLabels />
                    </ApexChart>
                }
                
                if (_viewModel.ShowTypesAmountChart)
                {
                    <MudText Typo="Typo.h6" Class="mt-2"><strong>@_viewModel.Localizer["Types amount chart"]</strong></MudText>
                    <MudDivider Class="my-2" Style="height: 3px;"/>

                    <ApexChart TItem="ApexChartValue<int>" >
                        <ApexPointSeries TItem="ApexChartValue<int>"
                            Items="_viewModel.TypesApexValues"
                            SeriesType="SeriesType.Donut"
                            XValue="@(e => e.Label)"
                            YValue="@(e => e.Value)"
                            PointColor="e=> e.Color" ShowDataLabels />
                    </ApexChart>
                }
            }
            else
            {
                <MudText>No operations available.</MudText>
            }
        </MudCardContent>
    </MudCard>
    }
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnInitialized();
    }

    
}