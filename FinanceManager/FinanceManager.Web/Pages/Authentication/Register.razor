@page "/register"
@using FinanceManager.Web.Services.APIServices.Managers.TokenManager
@layout MainLayout
@attribute [AllowAnonymous]
@inject FinanceManager.Web.ViewModels.Pages.Authorization.RegisterViewModel _viewModel

<EditForm EditContext="@_viewModel.EditContext" OnValidSubmit="@_viewModel.SubmitAsync">
    <DataAnnotationsValidator/>
    <MudGrid>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudIcon Icon="@CustomIcons.FinanceManager" Color="Color.Primary" Size="Size.Large" ViewBox="0 0 500 500" Style="width: 100px; height: 100px;" />
            </div>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-center">
                <MudText Typo="Typo.h4">@_viewModel.Localizer["Register"]</MudText>
            </div>
        </MudItem>
        <MudItem  xs="12">
            <div class="d-flex justify-center">
                <MudText>@_viewModel.Localizer["Already have an account?"] <MudLink Href="@PagesHref.Authentication.Login">@_viewModel.Localizer["Sign In"]</MudLink></MudText>
            </div>
        </MudItem>
        <MudItem  xs="12" sm="6" md="6">
            <MudTextField Immediate=true For="@(() => _viewModel.RegistrationModel.FirstName)" @bind-Value="_viewModel.RegistrationModel.FirstName" Label="@_viewModel.Localizer["First Name"]" />
        </MudItem>
        <MudItem  xs="12" sm="6" md="6">
            <MudTextField Immediate=true For="@(() => _viewModel.RegistrationModel.LastName)" @bind-Value="_viewModel.RegistrationModel.LastName" Label="@_viewModel.Localizer["Last Name"]" />
        </MudItem>
        <MudItem  xs="12" sm="6" md="6">
            <MudTextField Immediate=true T="string" Label="@_viewModel.Localizer["Email"]" Adornment="Adornment.End" AdornmentIcon="@CustomIcons.Gmail" @bind-Value="_viewModel.RegistrationModel.Email" For="@(() => _viewModel.RegistrationModel.Email)" />
        </MudItem>
        <MudItem  xs="12" sm="6" md="6">
            <MudTextField Immediate=true For="@(() => _viewModel.RegistrationModel.Password)" InputType="@_viewModel.PasswordInput" Adornment="Adornment.End" AdornmentIcon="@_viewModel.PasswordInputIcon" OnAdornmentClick="_viewModel.TogglePasswordVisibility" @bind-Value="_viewModel.RegistrationModel.Password" Label="@_viewModel.Localizer["Password"]" />
        </MudItem>
        <MudItem  xs="12" sm="6" md="6">
            <MudTextField Immediate=true For="@(() => _viewModel.RegistrationModel.ConfirmPassword)" InputType="InputType.Password" @bind-Value="_viewModel.RegistrationModel.ConfirmPassword" Label="@_viewModel.Localizer["Confirm Password"]" />
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-center">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@(!_viewModel.IsRegistrationModelValid)" Style="width: 100%;">@_viewModel.Localizer["Register"]</MudButton>
        </MudItem>
    </MudGrid>
</EditForm>