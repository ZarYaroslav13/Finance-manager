@page "/account"
@attribute [Authorize]
@inject FinanceManager.Web.ViewModels.Pages.Personal.AccountViewModel _viewModel

<MudPaper>
    <MudStack Spacing="5">
        <MudText Typo="Typo.h3" Align="Align.Center">@_viewModel.Localizer["Your account"]</MudText>

        <MudSwitch 
                   T="bool"
                   @bind-Value="_viewModel.EditMode"
                   ThumbIcon="@(_viewModel.SwitchThumbIcon)"
                   ThumbIconColor="@(_viewModel.SwitchThumbIconColor)" 
                   Label="@_viewModel.SwitchLabel"
                   Style="@_viewModel.SwitchLabelStyle"
                   Size="@Size.Large">
                
        </MudSwitch>

        <EditForm EditContext="@_viewModel.EditContext" OnValidSubmit="@_viewModel.SubmitAsync">
            <DataAnnotationsValidator />

            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudTextField Disabled="@(!_viewModel.EditMode)" Immediate=true For="@(() => _viewModel.AccountModel.FirstName)" @bind-Value="_viewModel.AccountModel.FirstName" Label="@_viewModel.Localizer["First Name"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Disabled="@(!_viewModel.EditMode)" Immediate=true For="@(() => _viewModel.AccountModel.LastName)" @bind-Value="_viewModel.AccountModel.LastName" Label="@_viewModel.Localizer["Last Name"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Disabled="@(!_viewModel.EditMode)" Immediate=true T="string" Label="@_viewModel.Localizer["Email"]" Adornment="Adornment.End" AdornmentIcon="@CustomIcons.Gmail" @bind-Value="_viewModel.AccountModel.Email" For="@(() => _viewModel.AccountModel.Email)" />
                </MudItem>
                <MudItem xs="12">
                    <MudButton 
                        ButtonType="ButtonType.Submit" 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" Size="Size.Large" 
                        Disabled="@(!(_viewModel.IsAccountModelValid && _viewModel.EditMode))" 
                        Style="width: 100%;">
                            @_viewModel.Localizer["Update credential"]
                    </MudButton>
                </MudItem>
                <MudItem xs="12">
                    <MudButton 
                        ButtonType="ButtonType.Button" 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" Size="Size.Large"
                        Disabled="@(!_viewModel.EditMode)"
                        Style="width: 100%;">
                            @_viewModel.Localizer["Change Password"]
                    </MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudStack>
</MudPaper>

@code{
    protected override void OnInitialized()
    {
        _viewModel.OnInitialized();
    }

}
