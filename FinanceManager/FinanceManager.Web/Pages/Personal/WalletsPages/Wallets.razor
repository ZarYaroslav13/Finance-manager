@page "/wallets"
@attribute [Authorize]
@inject FinanceManager.Web.ViewModels.Pages.Personal.WalletsPages.WalletsViewModel _viewModel


<MudContainer Class="p-4" Style="padding-bottom: 20px;">
    <MudGrid Spacing="5">
        @foreach (var wallet in _viewModel.Wallets)
        {
            <MudItem xs="12" sm="6" md="4" Class="card">
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h3">@wallet.Name</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit" Style="background-color:lightseagreen" />
                            <MudIconButton Icon="@CustomIcons.ActionIcons.Delete" Color="MudBlazor.Color.Error" Style="background-color:#fce4ec" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent Class="p-3 hover-elevation-6" Elevation="2">
                        <MudIcon Icon="@CustomIcons.Wallets.BlackWallet" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Large" ViewBox="0 0 500 500" Style="width: 250px; height: 250px; display: flex; justify-content: center;" />
                        <MudTextField ReadOnly="true" Value="@wallet.Balance" Typo="Typo.h4" Adornment="Adornment.End" AdornmentIcon="@CustomIcons.Money.Banknote" Margin=" Margin.Normal"></MudTextField>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudFab 
        Color="MudBlazor.Color.Tertiary" 
        StartIcon="@Icons.Material.Filled.Add" 
        DropShadow="true" 
        Style="position: fixed; bottom: 24px; right: 24px;" />
</MudContainer>

@code{
    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnIntinalAsync();
    }
}