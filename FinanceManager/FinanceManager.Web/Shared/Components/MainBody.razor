@using FinanceManager.Web
@inject MainBodyViewModel _viewModel;
@attribute [Authorize]

<MudAppBar Elevation="25" Style="background-image: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%);">
    <MudIcon Icon="@FinanceManager.Web.CustomIcons.FinanceManager" Size="MudBlazor.Size.Large" ViewBox="0 0 500 500" />
    <MudText Typo="Typo.h6" Class="ml-4">Finance Manager</MudText>
    <MudToolBar DisableGutters="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="MudBlazor.Color.Inherit" OnClick="@(() => @_viewModel.DrawerToggle())" Class="ml-3" />
    </MudToolBar>
    <MudSpacer />
    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
        <MudDivider Vertical="true" FlexItem="true" DividerType="DividerType.Middle" Class="mx-4 my-5" />
        <MudTooltip Text="@_viewModel.Localizer["Change language"]">
            <LanguageSelector />
        </MudTooltip>
        <MudTooltip Text="@_viewModel.Localizer["Toggle right-to-left/left-to-right"]">
            <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="MudBlazor.Color.Inherit" OnClick="@(() => _viewModel.RightToLeftToggle())" />
        </MudTooltip>
        <MudTooltip Text="@_viewModel.Localizer["Toggle Dark Mode"]">
            <MudIconButton Icon="@ThemeIcon" Color="MudBlazor.Color.Inherit" OnClick="@(() => _viewModel.ToggleDarkMode())" />
        </MudTooltip>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
        <MudTooltip Text="@_viewModel.Localizer["User preferences settings"]">
            <MudMenu Icon="@Icons.Material.Filled.Settings" Color="MudBlazor.Color.Inherit" Dense="true" Direction="Direction.Right" OffsetY="true">
                <div class="px-2">
                    <MudTooltip Text="@_viewModel.Localizer["Change language"]">
                        <LanguageSelector />
                    </MudTooltip>
                    <MudTooltip Text="@_viewModel.Localizer["Toggle right-to-left/left-to-right"]">
                        <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" OnClick="@(() => _viewModel.RightToLeftToggle())" />
                    </MudTooltip>
                    <MudTooltip Text="@_viewModel.Localizer["Toggle Dark Mode"]">
                        <MudIconButton Icon="@ThemeIcon" Color="MudBlazor.Color.Inherit" OnClick="@(() => _viewModel.ToggleDarkMode())" />
                    </MudTooltip>
                </div>
            </MudMenu>
        </MudTooltip>
    </MudHidden>
    <MudMenu Direction="@_viewModel.RightToLeftDirrection" OffsetX="true" Dense="true" Class="mt-1 ml-4">
        <ActivatorContent>
            <MudAvatar Color="MudBlazor.Color.Tertiary">@_viewModel.FirstLetterOfName</MudAvatar>
        </ActivatorContent>
        <ChildContent>
            <UserCard Class="mt-n2" />
            <MudDivider Class="mb-2" />
            <MudListItem T="object" Text="@_viewModel.Localizer["Account"]" Href="/account" Icon="@Icons.Material.Outlined.Person" />
            <MudListItem T="object" Text="@_viewModel.Localizer["Logout"]" Icon="@Icons.Material.Filled.Logout" OnClick="@(() => _viewModel.LogoutAsync())" />
        </ChildContent>
    </MudMenu>
</MudAppBar>
<MudDrawer @bind-Open="_viewModel.DrawerOpen" Elevation="25" ClipMode="DrawerClipMode.Always">
    <NavMenu />
</MudDrawer>
<MudMainContent>
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
        <CascadingAuthenticationState>
            @ChildContent
        </CascadingAuthenticationState>
    </MudContainer>
</MudMainContent>

@code{
    [Parameter]
    public RenderFragment ChildContent
    {
        get => _viewModel.ChildContent;
        set => _viewModel.ChildContent = value;
    }

    [Parameter]
    public EventCallback OnDarkModeToggle { 
        get => _viewModel.OnDarkModeToggle; 
        set => _viewModel.OnDarkModeToggle = value; }

    [Parameter]
    public EventCallback<bool> OnRightToLeftToggle
    {
        get => _viewModel.OnRightToLeftToggle;
        set => _viewModel.OnRightToLeftToggle = value;
    }

    [Parameter]
    public string ThemeIcon { get; set; } = Icons.Material.Filled.Brightness4;


    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _viewModel.OnAfterRenderAsync(firstRender);
    } 
}
