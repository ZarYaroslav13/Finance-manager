@using FinanceManager.Web.Services.APIServices.Managers.TokenManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Shared.Layout.MainLayout> _localizer
@inject FinanceManager.Web.ViewModels.MainBodyViewModel _viewModel;

<MudAppBar Elevation="25" Style="background-image: linear-gradient(109.6deg, rgba(22,126,91,1) 11.2%, rgba(223,82,36,1) 91.1%);">
    <MudIcon Icon="@FinanceManager.Web.CustomIcons.FinanceManager" Size="Size.Large" ViewBox="0 0 500 500" />
    <MudText Typo="Typo.h6" Class="ml-4">Finance Manager</MudText>
    <MudToolBar DisableGutters="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" OnClick="@(() => @_viewModel.DrawerToggle())" Class="ml-3" />
    </MudToolBar>
    <MudSpacer />
    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
        <MudDivider Vertical="true" FlexItem="true" DividerType="DividerType.Middle" Class="mx-4 my-5" />
        <LanguageSelector />
        <MudTooltip Text="@_localizer["Toggle right-to-left/left-to-right"]">
            <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="Color.Inherit" OnClick="@(() => _viewModel.RightToLeftToggle())" />
        </MudTooltip>
        <MudTooltip Text="@_localizer["Toggle Dark Mode"]">
            <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" OnClick="@(() => _viewModel.ToggleDarkMode())" />
        </MudTooltip>
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
        <LanguageSelector />
        <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" Dense="true" Direction="Direction.Right" OffsetY="true">
            <div class="px-2">
                <MudIconButton Icon="@Icons.Material.Filled.FormatTextdirectionRToL" Color="Color.Inherit" OnClick="@(() => _viewModel.RightToLeftToggle())" />
                <MudIconButton Icon="@Icons.Material.Filled.Brightness4" Color="Color.Inherit" OnClick="@(() => _viewModel.ToggleDarkMode())" />
            </div>
        </MudMenu>
    </MudHidden>
    <MudMenu Direction="@_viewModel.RightToLeftDirrection" OffsetX="true" Dense="true" Class="mt-1 ml-4">
        <ActivatorContent>
            <MudAvatar Color="Color.Tertiary">@_viewModel.FirstLetterOfName</MudAvatar>
        </ActivatorContent>
        <ChildContent>
            <UserCard Class="mt-n2" />
            <MudDivider Class="mb-2" />
            <MudListItem T="object" Text="@_localizer["Account"]" Href="/account" Icon="@Icons.Material.Outlined.Person" />
            <MudListItem T="object" Text="@_localizer["Logout"]" Icon="@Icons.Material.Filled.Logout" OnClick="@(() => _viewModel.LogoutAsync())" />
        </ChildContent>
    </MudMenu>
</MudAppBar>
<MudDrawer @bind-Open="_viewModel.DrawerOpen" Elevation="25" ClipMode="DrawerClipMode.Always">
    <NavMenu />
</MudDrawer>
<MudMainContent>
    <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
        <CascadingAuthenticationState>
            @_viewModel.ChildContent
        </CascadingAuthenticationState>
    </MudContainer>
</MudMainContent>

@code{
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public EventCallback OnDarkModeToggle { 
        get => _viewModel.OnDarkModeToggle; 
        set => _viewModel.OnDarkModeToggle = value; }

    [Parameter]
    public EventCallback<bool> OnRightToLeftToggle
    {
        get => _viewModel.OnRightToLeftToggle;
        set => _viewModel.OnRightToLeftToggle = value;
    }


    protected override async Task OnInitializedAsync()
    {
        await _viewModel.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _viewModel.OnAfterRenderAsync(firstRender);
    } 
}
