@namespace FinanceManager.Web.Shared.Dialogs.Accounts
@using FinanceManager.Domain.UseCases.Accounts.Commands.Commands.UpdatePasswordAccountCommand
@attribute [Authorize]
@inject FinanceManager.Web.ViewModels.Dialogs.Accounts.ChangePasswordDialogViewModel _viewModel;
<MudDialog>
    <TitleContent>
        <div class="d-flex justify-center">
            <MudIcon Icon="@Icons.Material.Sharp.PersonAddAlt1" Class="mr-3 mb-n1" />
            <MudText Typo="Typo.h4"> @_viewModel.Localizer["Change password"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm EditContext="@_viewModel.EditContext" OnValidSubmit="@Submit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Immediate=true For="@(() => _viewModel.UpdateModel.OldPassword)" @bind-Value="_viewModel.UpdateModel.OldPassword" Label="@_viewModel.Localizer["Old password"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Immediate=true For="@(() => _viewModel.UpdateModel.NewPassword)" @bind-Value="_viewModel.UpdateModel.NewPassword" Label="@_viewModel.Localizer["New password"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Immediate=true For="@(() => _viewModel.UpdateModel.ConfirmNewPassword)" @bind-Value="_viewModel.UpdateModel.ConfirmNewPassword" Label="@_viewModel.Localizer["New password again"]" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@_viewModel.Localizer["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Submit" Disabled="!_viewModel.IsModelValid">
            @if (_viewModel.Changing)
            {
                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@_viewModel.Localizer["Changing"]</MudText>
            }
            else
            {
                <MudText>@_viewModel.Localizer["Change"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public Guid UserId{ get => _viewModel.UpdateModel.Id; set=> _viewModel.UpdateModel.Id = value; }

    async Task Submit()
    {
        await _viewModel.TryToUpdate(() =>
        {
            _navigationManager.NavigateTo(PagesHref.Personal.Account);
            MudDialog.Close(DialogResult.Ok(true));
        });
    }
    void Cancel() => MudDialog.Cancel();
}