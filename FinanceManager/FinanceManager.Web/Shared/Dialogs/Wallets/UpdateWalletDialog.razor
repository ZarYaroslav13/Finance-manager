@namespace FinanceManager.Web.Shared.Dialogs.Wallets
@using FinanceManager.Application.UseCases.Wallets.Commands.UpdateWalletCommand
@attribute [Authorize]
@inject FinanceManager.Web.ViewModels.Dialogs.Wallets.UpdateWalletDialogViewModel _viewModel;
<MudDialog>
    <TitleContent>
        <div class="d-flex justify-center">
            <MudText Typo="Typo.h4"> <MudIcon Icon="@Icons.Material.Sharp.PersonAddAlt1" Class="mr-3 mb-n1" /> @_viewModel.Localizer["Update wallet"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm EditContext="@_viewModel.EditContext" OnValidSubmit="@Submit">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Immediate=true For="@(() => _viewModel.UpdateModel.Name)" @bind-Value="_viewModel.UpdateModel.Name" Label="@_viewModel.Localizer["Name"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Immediate=true For="@(() => _viewModel.UpdateModel.Balance)" @bind-Value="_viewModel.UpdateModel.Balance" Label="@_viewModel.Localizer["Balance"]" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@_viewModel.Localizer["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Submit" Disabled="!_viewModel.IsModelValid">
            @if (_viewModel.Updating)
            {
                <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@_viewModel.Localizer["Updating"]</MudText>
            }
            else
            {
                <MudText>@_viewModel.Localizer["Update"]</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] 
    public UpdateWalletCommand CurrentInfo{ get => _viewModel.UpdateModel; set=> _viewModel.UpdateModel = value; }

    async Task Submit()
    {
        await _viewModel.TryToUpdate();

        MudDialog.Close(DialogResult.Ok(_viewModel.UpdateModel));
    }

    void Cancel() => MudDialog.Cancel();
}